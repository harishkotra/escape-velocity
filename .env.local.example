# AI Provider Configuration
# Set your OpenAI API key or any OpenAI-compatible provider key
OPENAI_API_KEY=sk-your-key-here

# Provider: "openai" (default) or "featherless"
AI_PROVIDER=openai

# Model override (optional, defaults to gpt-4o-mini for openai)
# AI_MODEL=gpt-4o-mini

# For Featherless provider:
# AI_PROVIDER=featherless
# AI_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
